# Drift vs. label heterogeneity -- 30 runs, one per (partition, alpha, seed).
# Submit from the repo root:  condor_submit jobs/drift_sweep.sub
# See jobs/experiments.md for what this measures.

executable              = jobs/drift_one.sh
arguments               = $(partition) $(alpha) $(seed)
initialdir              = $ENV(PWD)

output                  = jobs/logs/drift_$(partition)_$(alpha)_$(seed).out
error                   = jobs/logs/drift_$(partition)_$(alpha)_$(seed).err
log                     = jobs/logs/drift.log

request_cpus            = 2
request_gpus            = 1
request_memory          = 8GB
request_disk            = 4GB

should_transfer_files   = NO
getenv                  = True

queue partition, alpha, seed from jobs/drift_params.txt
