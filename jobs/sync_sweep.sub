# Train loss vs. synchronization interval -- 24 jobs (8 K values x 3 heterogeneity levels),
# three seeds inside each.  Submit the centralized reference separately:
#   condor_submit jobs/sync_sweep.sub
#   condor_submit jobs/sgd_baseline.sub
# See jobs/experiments.md.

universe                = docker
docker_image            = amirabedi/torch-with-other-stuff-1.0.2

executable              = jobs/sync_one.sh
arguments               = $(k) $(h)
initialdir              = $ENV(PWD)

request_cpus            = 2
request_gpus            = 1
request_memory          = 8GB

log                     = jobs/logs/sync.log
output                  = jobs/logs/sync_K$(k)_h$(h).out
error                   = jobs/logs/sync_K$(k)_h$(h).err

should_transfer_files   = NO

queue k, h from jobs/sync_params.txt
