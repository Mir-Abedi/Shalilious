# Centralized SGD reference at the effective batch (10 clients x 64 = 640) -- one job,
# three seeds. Serves all 32 panels: every cell spends the same 10-epoch budget.
universe                = docker
docker_image            = amirabedi/torch-with-other-stuff-1.0.2
executable              = jobs/sgd_mnist_matched.sh
initialdir              = $ENV(PWD)
request_cpus            = 2
request_gpus            = 1
request_memory          = 8GB
log                     = jobs/logs/sync_mnist.log
output                  = jobs/logs/sgd_mnist_matched.out
error                   = jobs/logs/sgd_mnist_matched.err
should_transfer_files   = NO
queue
